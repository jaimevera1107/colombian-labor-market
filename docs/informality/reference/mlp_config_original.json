{
  "feature_cols": [
    "year",
    "month",
    "population",
    "employed",
    "unemployed",
    "inactive",
    "pea",
    "pet",
    "participation_rate",
    "employment_rate",
    "unemployment_rate",
    "inactivity_rate",
    "month_sin",
    "month_cos",
    "employed_pct",
    "unemployed_pct",
    "inactive_pct",
    "pea_pct",
    "pet_pct",
    "employed_share_monthly",
    "unemployed_share_monthly",
    "inactive_share_monthly",
    "pea_share_monthly",
    "pet_share_monthly",
    "population_share_monthly",
    "pop_urban_pct",
    "pop_rural_pct",
    "participation_rate_cluster",
    "employment_rate_cluster",
    "unemployment_rate_cluster",
    "inactivity_rate_cluster",
    "pet_cluster_mean",
    "pet_resid_cluster",
    "pet_cluster_ratio",
    "pea_cluster_mean",
    "pea_resid_cluster",
    "pea_cluster_ratio",
    "employed_cluster_mean",
    "employed_resid_cluster",
    "employed_cluster_ratio",
    "unemployed_cluster_mean",
