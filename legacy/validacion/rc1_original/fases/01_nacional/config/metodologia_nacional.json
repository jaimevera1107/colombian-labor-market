{
  "tempdisagg_version": "0.6.3",
  "splice": {
    "method": "ratio",
    "overlap_periods": 2
  },
  "disaggregation": {
    "method": "chow-lin-maxlog",
    "conversion": "average",
    "include_intercept": true,
    "completion": false,
    "padding": null,
    "truncated_rho": 0.0
  },
  "indicators": {
    "employed": ["real_value_unit_uvr"],
    "pea": ["consumer_price_index"],
    "pet": ["consumer_price_index"],
    "population": ["consumer_price_index"],
    "inactive": ["producer_price_index"],
    "unemployed": ["consumer_price_index"]
  },
  "publication_policy": {
    "allow_historical_release": false,
    "max_annual_identity_error_persons": 1.0,
    "max_monthly_identity_error_persons": 1.0,
    "reject_rho_boundary": true
  }
}
